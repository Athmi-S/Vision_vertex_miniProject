# =============================================================================
# VISION Adaptive Learning Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to git.
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development          # development | production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite path — relative to backend/
DATABASE_URL=sqlite:///./vision.db

# ---------------------------------------------------------------------------
# Security  (fill these in before running Stage 2 auth)
# ---------------------------------------------------------------------------
# Generate a strong secret key, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# First admin account  (seeded automatically on first startup in Stage 3)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
